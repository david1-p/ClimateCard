# 프로덕션 환경 변수 예시 파일
# 실제 배포 시 .env.production 파일을 생성하고 아래 값들을 실제 값으로 변경하세요

# ======================
# Database (PostgreSQL)
# ======================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=climate_transport
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL 성능 설정
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_WORK_MEM=8MB
POSTGRES_MEMORY_LIMIT=512M

# ======================
# Redis
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb
REDIS_MEMORY_LIMIT=256M

# ======================
# API Keys
# ======================
# 공공 데이터 포털 서비스 키
PUBLIC_API_SERVICE_KEY=YOUR_PUBLIC_API_SERVICE_KEY_HERE

# 서울시 Open API 키
SEOUL_API_KEY=YOUR_SEOUL_API_KEY_HERE

# 관리자 API 키 (openssl rand -base64 32 명령어로 생성)
ADMIN_API_KEY=YOUR_ADMIN_API_KEY_HERE

# ======================
# Sentry (에러 모니터링)
# ======================
SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# ======================
# Application
# ======================
SPRING_PROFILE=prod
BACKEND_PORT=8080
BACKEND_MEMORY_LIMIT=512M

# ======================
# Frontend (Vite)
# ======================
VITE_KAKAO_APP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY_HERE
VITE_KAKAO_OPENCHAT_URL=https://open.kakao.com/o/sJ6WrK8h
VITE_SENTRY_DSN=YOUR_FRONTEND_SENTRY_DSN_HERE
